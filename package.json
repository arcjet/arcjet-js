{
  "name": "arcjet-js",
  "version": "1.14.1",
  "private": true,
  "workspaces": [
    "*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "oxlint",
    "test-api": "turbo run test-api",
    "test-coverage": "turbo run test-coverage",
    "test": "turbo test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.11.8"
  },
  "overrides": {
    "@ai-sdk/anthropic": "4.0.81",
    "@ai-sdk/openai": "4.0.95",
    "@ai-sdk/provider-utils": "5.0.61",
    "@fastify/ajv-compiler": {
      "fast-uri": "3.1.8"
    },
    "@huggingface/transformers": {
      "sharp": ">=0.35.5"
    },
    "@nosecone/sveltekit": {
      "@sveltejs/kit": {
        "cookie": ">=0.7.2"
      }
    },
    "@strands-agents/sdk": {
      "@anthropic-ai/sdk": "0.135.0"
    },
    "adm-zip": "0.6.1",
    "ajv": {
      "fast-uri": "3.1.8"
    },
    "eve": {
      "undici": "^8.11.2"
    },
    "fast-json-stringify": {
      "fast-uri": "4.2.2"
    },
    "miniflare": {
      "sharp": ">=0.35.5",
      "undici": ">=7.29.1"
    }
  },
  "engines": {
    "node": ">=22.21.0 <23 || >=24.5.0",
    "npm": "^12.0.0"
  },
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "@firebase/util": false,
    "@google/genai": false,
    "@mongodb-js/zstd": false,
    "core-js-pure": false,
    "cpu-features": false,
    "esbuild": false,
    "fsevents": false,
    "node-liblzma": false,
    "onnxruntime-node": false,
    "protobufjs": false,
    "sharp": false,
    "ssh2": false,
    "workerd": false
  },
  "trustedDependencies": []
}

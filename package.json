{
  "name": "arcjet-js",
  "version": "1.17.0",
  "private": true,
  "workspaces": [
    "*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "oxlint",
    "test-api": "turbo run test-api",
    "test-coverage": "turbo run test-coverage",
    "test": "turbo test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "oxfmt": "0.78.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "turbo": "2.11.10"
  },
  "overrides": {
    "@nosecone/sveltekit": {
      "@sveltejs/kit": {
        "cookie": "^1.1.1"
      }
    },
    "@strands-agents/sdk": {
      "@anthropic-ai/sdk": "1.1.0"
    },
    "eve": {
      "undici@^8.0.0": "^8.11.2"
    },
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    },
    "gcp-metadata@8.1.4": {
      "gaxios": "7.1.4"
    },
    "miniflare": {
      "sharp": ">=0.35.5",
      "undici": ">=7.29.1"
    }
  },
  "engines": {
    "node": ">=22.21.0 <23 || >=24.5.0",
    "npm": "^12.0.0"
  },
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "@firebase/util": false,
    "@google/genai": false,
    "@mongodb-js/zstd": false,
    "core-js-pure": false,
    "cpu-features": false,
    "esbuild": false,
    "fsevents": false,
    "node-liblzma": false,
    "onnxruntime-node": false,
    "protobufjs": false,
    "sharp": false,
    "ssh2": false,
    "workerd": false
  },
  "trustedDependencies": []
}

{
  "name": "arcjet-js",
  "version": "1.12.0",
  "private": true,
  "workspaces": [
    "*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "oxlint --disable-nested-config",
    "test-api": "turbo run test-api",
    "test-coverage": "turbo run test-coverage",
    "test": "turbo test",
    "format": "oxfmt --disable-nested-config",
    "format:check": "oxfmt --disable-nested-config --check",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "oxfmt": "0.63.0",
    "oxlint": "1.77.0",
    "turbo": "2.10.10"
  },
  "engines": {
    "node": ">=22.21.0 <23 || >=24.5.0",
    "npm": "^12.0.0"
  },
  "packageManager": "npm@12.0.1",
  "allowScripts": {
    "@firebase/util": false,
    "@google/genai": false,
    "esbuild": false,
    "fsevents": false,
    "onnxruntime-node": false,
    "protobufjs": false,
    "sharp": false,
    "workerd": false
  }
}

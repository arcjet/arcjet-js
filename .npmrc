# Fail installs when a dependency adds a lifecycle script not explicitly
# reviewed in package.json's `allowScripts`. Reviewed dependencies keep
# scripts denied (their real binaries resolve via optionalDependencies
# platform packages instead); a new scripted dependency fails the build
# until it's added to the allowlist.
strict-allow-scripts=true

# Security and compatibility overrides are declared in package.json below.
# @ai-sdk pins keep the Cloudflare Think test adapter on its matching provider releases.
# sharp, cookie, and undici floors preserve security fixes despite older transitive ranges.
# adm-zip 0.6.1 fixes GHSA-xcpc-8h2w-3j85, GHSA-vwc7-r8mq-g2x9, and GHSA-7q85-xj36-vmfc.

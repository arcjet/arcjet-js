# Fail installs when a dependency adds a lifecycle script not explicitly
# reviewed in package.json's `allowScripts`. Reviewed dependencies keep
# scripts denied (their real binaries resolve via optionalDependencies
# platform packages instead); a new scripted dependency fails the build
# until it's added to the allowlist.
strict-allow-scripts=true

# oxlint@1.82.0 declares peerDependencies: { "oxlint-tsgolint": ">=7.0.2001" },
# which is not a real oxlint-tsgolint release line (it looks copy-pasted from
# a typescript-go build-number scheme) and can never be satisfied by the
# actual 0.x releases we install. It's the only broken peer range in the
# tree; everywhere else strict peer resolution already holds.
legacy-peer-deps=true
